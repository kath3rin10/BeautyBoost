<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="Modelo.Usuario,java.util.List,java.util.Map" %>
<% Usuario admin=(Usuario)session.getAttribute("usuarioLogueado"); if(admin==null||admin.getRolesIdRol()!=1){response.sendRedirect(request.getContextPath()+"/Vista/Login.jsp");return;} List<Map<String,Object>> resenas=(List<Map<String,Object>>)request.getAttribute("resenasAdmin"); String tituloAdmin="RESEÑAS DE CLIENTES"; %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reseñas | Beauty Boost</title><%@ include file="admin/includes/head.jspf" %></head>
<body class="bb-admin-body"><%@ include file="admin/includes/sidebar.jspf" %><main class="bb-main"><%@ include file="admin/includes/topbar.jspf" %><section class="bb-content"><div class="admin-page-heading"><div><span class="eyebrow">CLIENTES</span><h1>Reseñas</h1><p>Consulta el feedback registrado por los clientes.</p></div></div><section class="bb-panel"><div class="data-table-wrap"><table class="data-table"><thead><tr><th>Cliente</th><th>Producto</th><th>Valoración</th><th>Comentario</th><th>Fecha</th></tr></thead><tbody><% if(resenas!=null&&!resenas.isEmpty()){for(Map<String,Object> r:resenas){%><tr><td><strong><%=r.get("usuario")%></strong><br><small><%=r.get("correo")%></small></td><td><strong><%=r.get("producto") != null ? r.get("producto") : "Producto no disponible"%></strong><br><small>#<%=r.get("productoId")%></small></td><td><span class="review-admin-stars"><% int rr=((Number)r.get("calificacion")).intValue(); for(int st=1;st<=5;st++){ %><span class="<%=st<=rr?"filled":""%>">★</span><% } %></span> <%=r.get("calificacion")%>/5</td><td><%=r.get("observacion")%></td><td><%=r.get("fecha")%></td></tr><%}}else{%><tr><td colspan="5" class="empty-admin-state">No hay reseñas registradas.</td></tr><%}%></tbody></table></div></section></section></main><%@ include file="admin/includes/footer.jspf" %></body></html>
