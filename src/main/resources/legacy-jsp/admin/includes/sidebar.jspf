<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="Configuracion.CloudinaryConfig" %>
<%
    String adminUri = request.getRequestURI();
    String adminCtx = request.getContextPath();
    String dashActive = (adminUri.contains("adminDashboard") || adminUri.contains("AdminDashboardServlet")) ? "active" : "";
    String prodActive = (adminUri.contains("adminProductos") || adminUri.contains("AdminProductoServlet")) ? "active" : "";
    String pedidoActive = (adminUri.contains("adminPedidos") || adminUri.contains("AdminPedidoServlet")) ? "active" : "";
    String usuarioActive = (adminUri.contains("adminUsuarios") || adminUri.contains("admin_usuarios") || adminUri.contains("AdminUsuariosServlet") || adminUri.contains("AdminUsuarioServlet")) ? "active" : "";
    String resenaActive = (adminUri.contains("adminResenas") || adminUri.contains("AdminResenasServlet")) ? "active" : "";
%>
<aside class="bb-sidebar" id="bbSidebar">
    <button class="bb-sidebar-toggle" id="bbSidebarToggle" type="button" aria-label="Ocultar barra lateral" aria-expanded="true" title="Ocultar barra lateral">
        <i class="fas fa-chevron-left"></i>
    </button>
    <a class="bb-sidebar-brand" href="<%=adminCtx%>/AdminDashboardServlet" aria-label="Beauty Boost Dashboard">
        <img src="<%= Configuracion.CloudinaryConfig.BASE_URL %>logo.png" alt="Beauty Boost">
        <span>BEAUTY BOOST<small>BEAUTY STORE</small></span>
    </a>
    <div class="bb-admin-profile">
        <div class="bb-avatar"><i class="fas fa-user"></i></div>
        <div><strong><%= admin.getNombre() %> <%= admin.getApellido() %></strong><small>ADMIN</small></div>
    </div>
    <nav class="bb-nav" aria-label="Navegación administrativa">
        <a class="<%=dashActive%>" href="<%=adminCtx%>/AdminDashboardServlet"><i class="fas fa-chart-line"></i><span>Dashboard</span></a>
        <a class="<%=prodActive%>" href="<%=adminCtx%>/AdminProductoServlet"><i class="fas fa-box-open"></i><span>Productos</span></a>
        <a class="<%=pedidoActive%>" href="<%=adminCtx%>/AdminPedidoServlet"><i class="fas fa-receipt"></i><span>Pedidos</span></a>
        <a class="<%=usuarioActive%>" href="<%=adminCtx%>/AdminUsuariosServlet"><i class="fas fa-users"></i><span>Usuarios</span></a>
        <a class="<%=resenaActive%>" href="<%=adminCtx%>/AdminResenasServlet"><i class="fas fa-star"></i><span>Reseñas</span></a>
        <a class="" href="<%=adminCtx%>/ProductoServlet"><i class="fas fa-store"></i><span>Ver tienda</span></a>
    </nav>
    <div class="bb-sidebar-spacer"></div>
    <a class="bb-logout" href="<%=adminCtx%>/LoginServlet?action=logout"><i class="fas fa-right-from-bracket"></i><span>Cerrar Sesión</span></a>
</aside>
