<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="Modelo.Usuario" %><% Usuario admin=(Usuario)session.getAttribute("usuarioLogueado"); Usuario u=(Usuario)request.getAttribute("usuarioDetalle"); if(admin==null||admin.getRolesIdRol()!=1){response.sendRedirect(request.getContextPath()+"/Vista/Login.jsp");return;} if(u==null){response.sendRedirect(request.getContextPath()+"/AdminUsuariosServlet");return;} String tituloAdmin="PERFIL DE USUARIO";%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>Beauty Boost | Perfil de usuario</title><%@ include file="admin/includes/head.jspf" %></head><body class="bb-admin-body"><%@ include file="admin/includes/sidebar.jspf" %><main class="bb-main"><%@ include file="admin/includes/topbar.jspf" %><section class="bb-content">
<div class="admin-page-heading"><div><span class="eyebrow">PERFIL ADMINISTRATIVO</span><h1><%=u.getNombre()%> <%=u.getApellido()%></h1><p>ID #<%=u.getIdUsuario()%> · <%=u.getCorreo()%></p></div><a class="btn-admin secondary" href="${pageContext.request.contextPath}/AdminUsuariosServlet"><i class="fas fa-arrow-left"></i> Usuarios</a></div>
<section class="content-card"><div class="card-header"><div><h3>Datos completos de la cuenta</h3><span>Todos los campos administrativos son editables.</span></div></div>
<form action="${pageContext.request.contextPath}/AdminUsuariosServlet" method="POST" class="admin-create-grid" id="perfilUsuarioForm"><input type="hidden" name="action" value="actualizarUsuarioCompleto"><input type="hidden" name="idUsuario" value="<%=u.getIdUsuario()%>">
<label>Nombre<input class="form-control" name="nombre" value="<%=u.getNombre()%>" required></label><label>Apellido<input class="form-control" name="apellido" value="<%=u.getApellido()%>" required></label>
<label>Correo<input class="form-control" type="email" name="correo" value="<%=u.getCorreo()%>" required></label><label>Teléfono<input class="form-control" name="telefono" data-validacion="telefono" inputmode="numeric" pattern="[0-9]{7,15}" maxlength="15" value="<%=u.getTelefono()==null?"":u.getTelefono()%>" required></label>
<label>Documento<input class="form-control" name="numeroIdentificacion" data-validacion="documento" inputmode="numeric" pattern="[0-9]{6,15}" maxlength="15" value="<%=u.getNumeroIdentificacion()==null?"":u.getNumeroIdentificacion()%>" required></label><label>Fecha de nacimiento<input class="form-control" type="date" name="fechaNacimiento" value="<%=u.getFechaNacimiento()!=null?new java.text.SimpleDateFormat("yyyy-MM-dd").format(u.getFechaNacimiento()):""%>"></label>
<label>Tipo de documento<select class="form-control" name="tipoDocumento"><option value="1" <%=u.getTipoDocumentoIdTipoDocumento()==1?"selected":""%>>Cédula de Ciudadanía</option><option value="2" <%=u.getTipoDocumentoIdTipoDocumento()==2?"selected":""%>>Cédula de Extranjería</option><option value="3" <%=u.getTipoDocumentoIdTipoDocumento()==3?"selected":""%>>Pasaporte</option></select></label><label>Tipo de usuario<select class="form-control" name="tipoUsuario"><option value="1" <%=u.getTipoUsuarioIdTipoUsuario()==1?"selected":""%>>Administrador</option><option value="4" <%=u.getTipoUsuarioIdTipoUsuario()==4?"selected":""%>>Cliente</option></select></label>
<label>Rol<select class="form-control" name="rolesIdRol"><option value="1" <%=u.getRolesIdRol()==1?"selected":""%>>Administrador</option><option value="2" <%=u.getRolesIdRol()==2?"selected":""%>>Cliente</option></select></label><label>Estado<select class="form-control" name="estadoUsuario"><option value="Activo" <%=!"Inactivo".equalsIgnoreCase(u.getEstadoUsuario())?"selected":""%>>Activo</option><option value="Inactivo" <%= "Inactivo".equalsIgnoreCase(u.getEstadoUsuario())?"selected":""%>>Inactivo</option></select></label>
<label>Autorización de datos<select class="form-control" name="autorizacionDatos"><option value="SI" <%=!"NO".equalsIgnoreCase(u.getAutorizacionDatos())?"selected":""%>>Sí</option><option value="NO" <%= "NO".equalsIgnoreCase(u.getAutorizacionDatos())?"selected":""%>>No</option></select></label><div></div>
<div class="modal-actions full"><a class="btn-secondary" href="${pageContext.request.contextPath}/AdminUsuariosServlet">Cancelar</a><button class="btn-admin" type="submit"><i class="fas fa-save"></i> Guardar cambios</button></div></form></section></section></main><%@ include file="admin/includes/footer.jspf" %></body></html>
